    "@angular/compiler-cli": "^22.1.2",
    "@types/jasmine": "~4.3.0",
    "@types/qrcode": "^1.5.5",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
